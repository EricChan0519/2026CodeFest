# 本機開發與 Cloud Run 環境變數（不要放金鑰）
# TDX 金鑰只在本機跑 scripts/ 產生快照時以環境變數帶入，不進 repo、不進 Cloud Run。

# fake（預設）| valhalla | osrm
ROUTING_ENGINE=fake
# routing 服務網址（valhalla/osrm 用）
ROUTING_URL=
ROUTING_TIMEOUT_S=8
# none（預設，本機）| iam：routing 是私有 Cloud Run，adapter 從 metadata server 取 ID token。
# 用 iam 時，api 的服務帳號要有 routing 的 roles/run.invoker。
ROUTING_AUTH=
# commit 短碼；沒有時用 Cloud Run 的 K_REVISION
APP_VERSION=

# routing 使用的 OSM 資料日期，例如 2026-11-06
OSM_UPDATED_AT=
# 預設 api/data/stop_index.json
STOP_INDEX_PATH=
